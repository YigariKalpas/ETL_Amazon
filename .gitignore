# =============================================================================
# ETL_Amazon .gitignore
#
# 原则
#   1) 原始数据与大体量生成物绝不入库（体积是不可逆的成本，且第三方数据有使用条件）；
#      改为提交「校验值 + 采集清单 + 可复现脚本」。
#   2) 但不要全局忽略 *.csv / *.json —— 文档要求的统计、血缘、评价集、验收样本
#      属于必须提交的小体积证据，由目录约定区分，而非按扩展名一刀切。
#   3) 需要保留某个被忽略的样本时，用 ! 反选（见文末示例）。
# =============================================================================

# --- 1. 原始数据源（约 9.33 GB 文本 + 3.32 GB 压缩包，禁止入库）-------------
/movies.txt
/movies.txt/
movies.txt.gz
*.txt.gz

# --- 2. Python 运行环境与缓存 ------------------------------------------------
/.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- 3. 临时工作目录与编辑器残留 --------------------------------------------
/.tmp/
/tmp/
*.tmp
*.temp
*.bak
*.orig
*.rej
*.swp
*~
*~$*

# --- 4. 体量较大 / 二进制产物：数据库、列存、归档 ----------------------------
*.duckdb
*.duckdb.wal
*.sqlite
*.sqlite3
*.db
*.mdb
*.parquet
*.feather
*.orc
*.avro
*.pkl
*.pickle
*.npy
*.npz
*.h5
*.hdf5
*.zip
*.7z
*.rar
*.tar
*.tgz
*.gz
*.bz2
*.xz

# --- 5. 采集快照与原始/中间层（按目录约定忽略）-------------------------------
/data/raw/
/data/bronze/
/data/silver/
/data/staging/
/data/snapshots/
/raw/
/raw_pages/
/snapshots/
/cache/
*.html
*.htm
*.mhtml

# 注：如需提交少量样本页面作为验收/解析测试素材，用 ! 反选，例如：
# !tests/fixtures/pages/**/*.html

# --- 6. 日志与本机工具状态 ---------------------------------------------------
*.log
logs/
/.dsh-project-memory/
.dsh-*

# --- 7. 密钥与凭证（严禁入库）------------------------------------------------
secrets.json
.env
.env.*
*.pem
*.key
*.p12
credentials.json

# --- 8. 项目内第三方运行时（体积大、可重建；由 scripts\setup_pdi.cmd 生成）--------
/tools/

# --- 9. PDI/Kettle 运行期缓存（保留 kettle.properties 等配置）-------------------
/etl/kettle/.kettle/db.cache
/etl/kettle/.kettle/.spoon
/etl/kettle/.kettle/shared.xml
/etl/kettle/.kettle/logs/
